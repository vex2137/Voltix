import { Theme } from "../themes/theme.slint";
import { ControlRow } from "../models.slint";
export component TelemetryRows inherits VerticalLayout {
    in property <[ControlRow]> rows;
    spacing: 8px;
    for row in root.rows : VerticalLayout {
        spacing: 4px;
        Text { text: row.label; color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; }
        Text { text: row.value; color: Theme.text-primary; font-size: 14px; font-weight: 600; wrap: word-wrap; }
        if row.detail != "" : Text { text: row.detail; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; }
        Rectangle { height: 1px; background: Theme.border-subtle; }
    }
}

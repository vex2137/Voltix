import { Theme } from "../themes/theme.slint";
export component DesktopAction inherits Rectangle {
    in property <string> label;
    in property <int> kind; // secondary, primary, destructive
    in property <bool> enabled: true;
    callback clicked();
    min-width: 0px; height: 32px; preferred-width: 0px; horizontal-stretch: 1; vertical-stretch: 0;
    border-radius: Theme.radius-sm; border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : (root.kind == 1 ? Theme.accent : (root.kind == 2 ? Theme.accent-red.with-alpha(0.5) : Theme.border-subtle.with-alpha(0.65)));
    background: root.kind == 1 ? (pointer.pressed ? Theme.accent.with-alpha(0.75) : Theme.accent) : (pointer.pressed ? Theme.accent-soft : (pointer.has-hover ? Theme.bg-hover : Theme.bg-app));
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button; accessible-label: root.label;
    forward-focus: focus;
    focus := FocusScope { enabled: root.enabled; key-pressed(event) => {
        if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject;
    } }
    Text { x: 10px; width: max(0px,parent.width - 20px); height: 100%; text: root.label; color: root.kind == 1 ? Theme.on-accent : (root.kind == 2 ? Theme.accent-red : Theme.text-primary); horizontal-alignment: center; vertical-alignment: center; font-size: 12px; font-weight: root.kind == 1 ? 600 : 500; wrap: word-wrap; }
    pointer := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}
export component DesktopNavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> active;
    callback clicked();
    min-width: 0px; height: 36px; vertical-stretch: 0;
    border-radius: Theme.radius-sm;
    background: root.active || pointer.pressed ? Theme.accent-soft : (pointer.has-hover ? Theme.bg-hover : transparent);
    border-width: focus.has-focus ? 1px : 0px; border-color: Theme.accent;
    accessible-role: button; accessible-label: root.label; forward-focus: focus;
    if root.active : Rectangle { x: 0px; y: 8px; width: 3px; height: parent.height - 16px; border-radius: 2px; background: Theme.accent; }
    HorizontalLayout { padding-left: 10px; padding-right: 6px; spacing: 8px;
        if root.has-icon : Rectangle {
            width: 20px;
            Image { y: (parent.height - self.height) / 2; source: root.icon; width: 20px; height: 20px; image-fit: contain; colorize: root.active ? Theme.accent : Theme.text-secondary; }
        }
        Text { text: root.label; color: root.active ? Theme.accent : Theme.text-secondary; font-size: 12.5px; font-weight: root.active ? 600 : 500; vertical-alignment: center; overflow: elide; min-width: 0px; }
    }
    focus := FocusScope { key-pressed(event) => { if event.text == Key.Return || event.text == " " { root.clicked(); return accept; } return reject; } }
    pointer := TouchArea { clicked => { focus.focus(); root.clicked(); } }
}

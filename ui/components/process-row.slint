import { Theme } from "../themes/theme.slint";
import { I18n } from "../i18n/strings.slint";
import { ProcessItem } from "../models.slint";
export component ProcessRow inherits Rectangle {
    in property <ProcessItem> item;
    in property <bool> header;
    in property <bool> selected;
    in property <bool> keyboard-select;
    changed selected => { if root.selected && root.keyboard-select { focus.focus(); } }
    callback activate(string);
    private property <string> focused-key;
    callback step(int);
    private property <bool> show-user: root.width >= 650px;
    private property <bool> show-state: root.width >= 800px;
    private property <bool> show-threads: root.width >= 940px;
    // Explicit horizontal constraints keep optional columns out of layout cycles.
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    max-width: 100000px;
    height: root.header ? 30px : 40px;
    background: root.header ? Theme.bg-elevated : (root.selected ? Theme.accent-soft : (pointer.has-hover ? Theme.bg-elevated : transparent));
    border-radius: 4px;
    border-width: focus.has-focus && root.selected && !root.header ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: list-item;
    accessible-label: root.header ? I18n.proc-process-table : root.item.name + ", PID " + root.item.pid + ", CPU " + root.item.cpu-text + ", RAM " + root.item.memory-text + " MiB, " + root.item.state;
    forward-focus: focus;
    focus := FocusScope {
        enabled: !root.header;
        changed has-focus => { if self.has-focus { root.focused-key = root.item.key; } }
        key-pressed(event) => {
            if !root.header && (event.text == Key.Return || event.text == " ") { root.activate(root.focused-key); return accept; }
            if !root.header && event.text == Key.DownArrow { root.step(1); return accept; }
            if !root.header && event.text == Key.UpArrow { root.step(-1); return accept; }
            return reject;
        }
    }
    pointer := TouchArea {
        enabled: !root.header;
        clicked => { root.focused-key = root.item.key; focus.focus(); root.activate(root.item.key); }
    }
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        Text { text: root.header ? I18n.proc-name : root.item.name; horizontal-stretch: 1; min-width: 60px; color: Theme.text-primary; font-size: 12px; font-weight: root.header ? 600 : 500; overflow: elide; vertical-alignment: center; }
        if root.width >= 400px : Text { text: root.header ? "PID" : root.item.pid; width: 54px; color: Theme.text-secondary; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        Rectangle {
            width: 76px;
            if !root.header : Rectangle { x: parent.width * (1 - root.item.cpu / 100); y: parent.height - 7px; height: 3px; width: parent.width * root.item.cpu / 100; border-radius: 2px; background: root.item.hot ? Theme.accent-amber : Theme.cpu-color.with-alpha(0.55); }
            Text { width: 100%; height: 100%; text: root.header ? "CPU" : root.item.cpu-text; color: root.item.hot && !root.header ? Theme.accent-amber : Theme.text-primary; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
        }
        Rectangle {
            width: 86px;
            if !root.header : Rectangle { x: parent.width * (1 - root.item.ram / 100); y: parent.height - 7px; height: 3px; width: parent.width * root.item.ram / 100; border-radius: 2px; background: Theme.accent-emerald.with-alpha(0.55); }
            Text { width: 100%; height: 100%; text: root.header ? "RAM (MiB)" : root.item.memory-text; color: Theme.text-primary; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
        }
        if root.show-user : Text { text: root.header ? I18n.proc-user : root.item.user; width: 84px; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; overflow: elide; }
        if root.show-state : Text { text: root.header ? I18n.proc-state : root.item.state; width: 82px; color: root.item.running && !root.header ? Theme.accent-emerald : Theme.text-secondary; font-size: 11px; vertical-alignment: center; overflow: elide; }
        if root.show-threads : Text { text: root.header ? I18n.proc-threads : root.item.threads; width: 46px; color: Theme.text-secondary; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    }
}

import { Theme } from "../themes/theme.slint";

export component Card inherits Rectangle {
    background: Theme.bg-card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border-subtle;
}

export component SectionTitle inherits Text {
    color: Theme.text-primary;
    font-size: 14px;
    font-weight: 600;
}

export component ProgressBar inherits Rectangle {
    in property <float> value: 0.0;
    in property <color> bar-color: Theme.accent;
    in property <bool> available: true;

    height: 7px;
    border-radius: 4px;
    background: Theme.track-bg;
    clip: true;

    Rectangle {
        x: 0px;
        y: 0px;
        height: parent.height;
        width: root.available ? parent.width * clamp(root.value / 100.0, 0.0, 1.0) : 0px;
        border-radius: 4px;
        background: root.bar-color;
    }
}

export component SummaryCard inherits Card {
    in property <string> label;
    in property <string> primary-value;
    in property <string> secondary-value: "";
    in property <float> progress: 0.0;
    in property <bool> show-progress: true;
    in property <int> status: 0; // 0=Available, 1=Unavailable, 2=Unsupported, 3=PermissionError
    in property <color> accent-color: Theme.accent;
    in property <bool> compact: false;

    VerticalLayout {
        padding: Theme.interface-mode == 1 ? 8px : (root.compact ? 12px : 16px);
        spacing: root.compact ? 5px : 7px;

        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: root.compact ? 11.5px : 12px;
            font-weight: 500;
            wrap: word-wrap;
        }

        Text {
            text: root.primary-value;
            color: root.status == 0 ? Theme.text-primary : (root.status == 3 ? Theme.accent-amber : Theme.text-muted);
            font-size: root.status == 0 ? (Theme.interface-mode == 2 ? 28px : (root.compact ? 18px : 22px)) : 13px;
            font-weight: 700;
            wrap: word-wrap;
        }

        if root.show-progress && root.status == 0 : ProgressBar {
            value: root.progress;
            bar-color: root.accent-color;
            available: true;
        }

        if root.secondary-value != "" : Text {
            text: root.secondary-value;
            color: Theme.text-muted;
            font-size: root.compact ? 11px : 12px;
            wrap: word-wrap;
        }
    }
}

export component KeyValueRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <int> status: 0;
    in property <bool> show-divider: true;
    in property <bool> compact: false;

    min-height: root.compact ? 64px : (Theme.interface-mode == 1 ? 28px : 36px);

    VerticalLayout {
        if !root.compact : HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 12px;

            Text {
                text: root.label;
                color: Theme.text-secondary;
                font-size: 13px;
                vertical-alignment: center;
                width: 42%;
                max-width: 220px;
                wrap: word-wrap;
            }

            Text {
                text: root.value;
                color: root.status == 0 ? Theme.text-primary : (root.status == 3 ? Theme.accent-amber : Theme.text-muted);
                font-size: 13px;
                font-weight: root.status == 0 ? 600 : 500;
                vertical-alignment: center;
                horizontal-alignment: left;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }

        if root.compact : VerticalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 3px;

            if root.label != "" : Text {
                text: root.label;
                color: Theme.text-muted;
                font-size: 11.5px;
                font-weight: 500;
                wrap: word-wrap;
            }

            Text {
                text: root.value;
                color: root.status == 0 ? Theme.text-primary : (root.status == 3 ? Theme.accent-amber : Theme.text-muted);
                font-size: 13px;
                font-weight: root.status == 0 ? 600 : 500;
                wrap: word-wrap;
            }
        }

        if root.show-divider : Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }
    }
}

export component DiagnosticNotice inherits Card {
    in property <string> title;
    in property <string> body;
    in property <bool> compact: false;

    background: Theme.bg-elevated;
    border-color: Theme.border-strong;

    HorizontalLayout {
        Rectangle {
            width: 3px;
            background: Theme.accent-amber;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            padding: Theme.interface-mode == 1 ? 8px : (root.compact ? 12px : 16px);
            spacing: 4px;

            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: 12.5px;
                font-weight: 700;
                wrap: word-wrap;
            }

            Text {
                text: root.body;
                color: Theme.text-secondary;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}

export component SegmentedOption inherits TouchArea {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> compact: false;

    height: root.compact ? 42px : 32px;
    mouse-cursor: pointer;

    Rectangle {
        border-radius: Theme.radius-sm;
        background: root.active ? Theme.accent-soft : (root.has-hover ? Theme.bg-hover : Theme.bg-elevated);
        border-width: 1px;
        border-color: root.active ? Theme.accent : Theme.border-subtle;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            alignment: center;

            Text {
                text: root.label;
                color: root.active ? Theme.accent : Theme.text-primary;
                font-size: 12px;
                font-weight: root.active ? 600 : 500;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

import { Button } from "std-widgets.slint";
import { Theme } from "../themes/theme.slint";
import { I18n } from "../i18n/strings.slint";
component Destination inherits Rectangle {
    in property <bool> primary;
    callback clicked();
    in property <string> label;
    in property <string> glyph;
    Button { width: 100%; height: 100%; text: ""; accessible-label: root.label; primary: root.primary; clicked => { root.clicked(); } }
    min-width: 0px; min-height: 60px;
    VerticalLayout {
        padding: 4px; spacing: 3px; alignment: center;
        Text { text: root.glyph; font-size: 16px; horizontal-alignment: center; color: root.primary ? Theme.on-accent : Theme.text-secondary; }
        Text { text: root.label; font-size: 11px; horizontal-alignment: center; color: root.primary ? Theme.on-accent : Theme.text-secondary; wrap: word-wrap; }
    }
}
export component BottomNav inherits Rectangle {
    in-out property <int> current-page: 0;
    in property <length> bottom-inset;
    in property <length> left-inset;
    in property <length> right-inset;
    height: 65px + root.bottom-inset;
    vertical-stretch: 0;
    background: Theme.bg-sidebar;
    VerticalLayout {
        Rectangle { height: 1px; background: Theme.border-subtle; }
        HorizontalLayout {
            height: 64px;
            vertical-stretch: 0;
            padding-left: root.left-inset + 4px; padding-right: root.right-inset + 4px;
            padding-top: 4px; padding-bottom: 4px; spacing: 3px;
            for destination[index] in [0,1,2,8,12] : Destination {
                horizontal-stretch: 1; min-width: 0px; min-height: 56px;
                label: [I18n.nav-short-dashboard,"CPU","GPU",I18n.cc-battery-short,I18n.cc-more][index];
                glyph: ["⌂","▦","◈","⚡","•••"][index];
                primary: root.current-page == destination || (destination == 12 && root.current-page != 0 && root.current-page != 1 && root.current-page != 2 && root.current-page != 8);
                clicked => { root.current-page = destination; }
            }
        }
        if root.bottom-inset > 0px : Rectangle { height: root.bottom-inset; }
    }
}

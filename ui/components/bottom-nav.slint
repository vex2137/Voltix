import { Theme } from "../themes/theme.slint";
import { I18n } from "../i18n/strings.slint";

component BottomNavItem inherits TouchArea {
    in property <string> code;
    in property <string> label;
    in property <bool> active: false;

    horizontal-stretch: 1;
    min-width: 56px;
    height: 60px;
    mouse-cursor: pointer;

    Rectangle {
        border-radius: Theme.radius-sm;
        background: root.active ? Theme.accent-soft : (root.has-hover ? Theme.bg-hover : transparent);
        border-width: root.active ? 1px : 0px;
        border-color: Theme.accent-soft;

        VerticalLayout {
            padding-top: 5px;
            padding-bottom: 5px;
            padding-left: 4px;
            padding-right: 4px;
            spacing: 4px;
            alignment: center;

            HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 32px;
                    height: 22px;
                    border-radius: 5px;
                    background: root.active ? Theme.accent : Theme.bg-elevated;

                    Text {
                        text: root.code;
                        color: root.active ? #0b0f17 : Theme.text-secondary;
                        font-size: 10.5px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: root.label;
                color: root.active ? Theme.text-primary : Theme.text-secondary;
                font-size: 11.5px;
                font-weight: root.active ? 700 : 500;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }
}

export component BottomNav inherits Rectangle {
    in-out property <int> current-page: 0;
    in property <length> bottom-inset: 0px;
    in property <length> left-inset: 0px;
    in property <length> right-inset: 0px;

    background: Theme.bg-sidebar;

    VerticalLayout {
        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        Flickable {
            height: 66px;
            interactive: self.viewport-width > self.width;
            viewport-width: max(self.width, 432px + root.left-inset + root.right-inset);
            viewport-height: 66px;

            HorizontalLayout {
                width: parent.viewport-width;
                height: 66px;
                padding-left: 8px + root.left-inset;
                padding-right: 8px + root.right-inset;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: 4px;

                BottomNavItem {
                    code: "OV";
                    label: I18n.nav-short-dashboard;
                    active: root.current-page == 0;
                    clicked => { root.current-page = 0; }
                }
                BottomNavItem {
                    code: "CP";
                    label: I18n.nav-short-cpu;
                    active: root.current-page == 1;
                    clicked => { root.current-page = 1; }
                }
                BottomNavItem {
                    code: "GP";
                    label: I18n.nav-short-gpu;
                    active: root.current-page == 2;
                    clicked => { root.current-page = 2; }
                }
                BottomNavItem {
                    code: "RM";
                    label: I18n.nav-short-memory;
                    active: root.current-page == 3;
                    clicked => { root.current-page = 3; }
                }
                BottomNavItem {
                    code: "DS";
                    label: I18n.nav-short-storage;
                    active: root.current-page == 4;
                    clicked => { root.current-page = 4; }
                }
                BottomNavItem {
                    code: "SY";
                    label: I18n.nav-short-system;
                    active: root.current-page == 5;
                    clicked => { root.current-page = 5; }
                }
                BottomNavItem {
                    code: "ST";
                    label: I18n.nav-short-settings;
                    active: root.current-page == 6;
                    clicked => { root.current-page = 6; }
                }
            }
        }

        if root.bottom-inset > 0px : Rectangle {
            height: root.bottom-inset;
        }
    }
}

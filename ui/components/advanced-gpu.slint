import { CheckBox, Button } from "std-widgets.slint";
import { Theme } from "../themes/theme.slint";
import { I18n } from "../i18n/strings.slint";
import { ControlRow } from "../models.slint";
import { Card, SectionTitle } from "common.slint";
import { CompactMetricRows } from "compact-metric-rows.slint";
export component AdvancedGpu inherits Card {
    in-out property <bool> enabled;
    in property <bool> running;
    in property <bool> authorized;
    in property <bool> installed;
    in property <[ControlRow]> rows;
    in property <[ControlRow]> sources;
    private property <bool> technical;
    callback action(int);
    VerticalLayout { padding: 12px; spacing: 8px; alignment: start;
        SectionTitle { text: I18n.shz-title; }
        CheckBox { text: I18n.shz-enable; checked <=> root.enabled; toggled => { root.action(self.checked ? 1 : 2); } }
        CompactMetricRows { rows: root.rows; end-index: 2; }
        if root.enabled : VerticalLayout { spacing: 6px;
            Button { text: root.authorized ? I18n.shz-reconnect : I18n.shz-authorize; enabled: root.running; min-height: 40px; clicked => { root.action(3); } }
            Button { text: root.installed ? I18n.shz-manager : I18n.shz-install; min-height: 40px; clicked => { root.action(4); } }
            CompactMetricRows { rows: root.rows; start-index: 2; }
            CheckBox { text: I18n.shz-technical; checked <=> root.technical; }
            if root.technical : VerticalLayout { spacing: 8px; alignment: start;
                for source in root.sources : VerticalLayout { spacing: 3px; alignment: start;
                    Text { text: source.label + " · " + source.value; color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; vertical-stretch: 0; }
                    Text { text: source.detail; color: Theme.text-muted; font-size: 11px; wrap: char-wrap; min-width: 0px; vertical-stretch: 0; }
                    Rectangle { height: 1px; background: Theme.border-subtle; }
                }
            }
        }
        Text { vertical-stretch: 0; text: I18n.shz-note; color: Theme.text-muted; font-size: 11px; wrap: word-wrap; }
    }
}

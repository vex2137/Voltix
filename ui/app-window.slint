import { Palette } from "std-widgets.slint";
import { Theme } from "themes/theme.slint";
import { I18n } from "i18n/strings.slint";
import { CoreRowItem, GpuItem, StorageItem, SystemGpuItem } from "models.slint";
import { Sidebar } from "components/sidebar.slint";
import { BottomNav } from "components/bottom-nav.slint";
import { PerformancePage } from "pages/performance.slint";
import { DashboardPage } from "pages/dashboard.slint";
import { CpuPage } from "pages/cpu.slint";
import { GpuPage } from "pages/gpu.slint";
import { MemoryPage } from "pages/memory.slint";
import { StoragePage } from "pages/storage.slint";
import { SystemPage } from "pages/system.slint";
import { SettingsPage } from "pages/settings.slint";

export { Theme, I18n, CoreRowItem, GpuItem, StorageItem, SystemGpuItem }

export component AppWindow inherits Window {
    title: I18n.app-name + " " + I18n.app-version;
    icon: @image-url("../assets/icons/voltix.svg");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 320px;
    min-height: 480px;
    background: Theme.bg-app;

    // Update breakpoints after sizing, avoiding a width -> minimum-layout -> width loop.
    private property <bool> compact-mode: false;
    private property <bool> narrow-mode: false;
    function update-breakpoints() {
        root.compact-mode = root.width < 760px;
        root.narrow-mode = root.width - root.safe-area-insets.left - root.safe-area-insets.right < 360px;
    }
    changed width => { root.update-breakpoints(); }
    changed safe-area-insets => { root.update-breakpoints(); }
    in-out property <int> current-page: 0;

    // Header & status properties
    in property <string> os-badge-text: "Linux";
    in property <string> polling-badge-text: "1000 ms";
    in property <string> cpu-header-label: "CPU";

    // Dashboard & shared telemetry properties
    in property <string> dash-cpu-card-label: "CPU Utilization";
    in property <string> dash-cpu-util-text: "-";
    in property <float> dash-cpu-util-percent: 0.0;
    in property <int> dash-cpu-util-status: 1;
    in property <string> dash-cpu-secondary-text: "";
    in property <string> dash-cpu-chart-title: "CPU Utilization History (60s)";

    in property <string> cpu-sys-util-text: "-";
    in property <float> cpu-sys-util-percent: 0.0;
    in property <int> cpu-sys-util-status: 1;
    in property <string> cpu-process-util-text: "-";
    in property <float> cpu-process-util-percent: 0.0;
    in property <int> cpu-process-util-status: 1;
    in property <string> cpu-temp-text: "-";
    in property <string> cpu-temp-source: "";
    in property <int> cpu-temp-status: 1;

    in property <string> dash-gpu-util-text: "-";
    in property <float> dash-gpu-util-percent: 0.0;
    in property <int> dash-gpu-util-status: 1;
    in property <string> dash-gpu-temp-text: "-";

    in property <string> dash-vram-util-text: "-";
    in property <float> dash-vram-util-percent: 0.0;
    in property <int> dash-vram-util-status: 1;
    in property <string> dash-vram-detail-text: "";

    in property <string> ram-util-text: "-";
    in property <float> ram-util-percent: 0.0;
    in property <int> ram-util-status: 1;
    in property <string> ram-detail-text: "";

    in property <string> uptime-text: "-";
    in property <int> uptime-status: 1;
    in property <string> kernel-text: "-";
    in property <int> kernel-status: 1;

    // Charts
    in property <string> cpu-line-commands: "";
    in property <string> cpu-area-commands: "";
    in property <bool> cpu-has-history: false;

    in property <string> ram-line-commands: "";
    in property <string> ram-area-commands: "";
    in property <bool> ram-has-history: false;

    in property <string> gpu-line-commands: "";
    in property <string> gpu-area-commands: "";
    in property <bool> gpu-has-history: false;
    in property <string> gpu-chart-empty-text: "";

    // CPU page properties
    in property <string> cpu-model: "-";
    in property <int> cpu-model-status: 1;
    in property <string> cpu-vendor: "-";
    in property <int> cpu-vendor-status: 1;
    in property <string> cpu-arch: "-";
    in property <string> cpu-cores-threads: "-";
    in property <string> cpu-freq-text: "-";
    in property <int> cpu-freq-status: 1;
    in property <string> cpu-chart-title: "Overall CPU Utilization (60s)";
    in property <string> cpu-notice-text: "";
    in property <[CoreRowItem]> cpu-core-rows;

    // GPU page properties
    in property <[GpuItem]> gpus;
    in property <GpuItem> selected-gpu;
    in property <int> selected-gpu-index: 0;
    in property <bool> has-gpus: false;
    in property <string> gpu-notice-text: "";

    // Memory page properties
    in property <string> mem-total-text: "-";
    in property <int> mem-total-status: 1;
    in property <string> mem-used-text: "-";
    in property <int> mem-used-status: 1;
    in property <string> mem-available-text: "-";
    in property <int> mem-available-status: 1;
    in property <string> swap-total-text: "-";
    in property <int> swap-total-status: 1;
    in property <string> swap-used-text: "-";
    in property <int> swap-used-status: 1;
    in property <string> swap-util-text: "-";
    in property <float> swap-util-percent: 0.0;
    in property <int> swap-util-status: 1;
    in property <string> mem-notice-text: "";

    // Storage page properties
    in property <[StorageItem]> disks;
    in property <string> storage-notice-text: "";

    // System page properties
    in property <string> os-name: "-";
    in property <int> os-status: 1;
    in property <string> hostname: "-";
    in property <int> hostname-status: 1;
    in property <[SystemGpuItem]> system-gpus;

    // Settings properties & callbacks
    in-out property <int> theme-mode: 1;
    in-out property <int> language-mode: 0;
    in-out property <int> temp-unit: 0;
    in-out property <int> polling-ms: 1000;
    in property <string> config-path: "";

    callback page-changed();
    changed current-page => { root.page-changed(); }
    in property <bool> overlay-linux;
    in property <bool> overlay-detected;
    in property <bool> overlay-enabled;
    in property <int> overlay-position;
    in property <int> overlay-font;
    in property <int> overlay-opacity;
    in property <bool> overlay-fps;
    in property <bool> overlay-frametime;
    in property <bool> overlay-cpu;
    in property <bool> overlay-gpu;
    in property <bool> overlay-temperatures;
    in property <bool> overlay-memory;
    in property <bool> overlay-gpu-power;
    in property <bool> overlay-opengl-dlsym;
    in property <string> overlay-command;
    callback change-overlay(int, int);
    callback refresh-overlay();
    callback manage-mangohud(string, string, string, string, bool);
    in property <string> manager-config;
    in property <string> manager-status;
    in property <string> manager-preview;
    in property <float> manager-preview-size;
    in property <string> manager-target;
    in property <string> manager-game;
    in property <[string]> manager-profiles;
    in property <[bool]> manager-flags;
    in property <[string]> manager-values;
    in property <color> manager-color;
    in property <color> manager-background;
    callback copy-overlay(string);
    in property <string> overlay-copy-status;
    in-out property <string> custom-theme-json;
    in property <string> custom-theme-status;
    in property <[string]> saved-theme-names;
    callback apply-custom-theme(string, int);
    callback load-custom-theme(string);
    callback change-palette(int);
    callback change-interface(int);
    callback change-accent(int);
    callback select-gpu(int);
    callback change-theme(int);
    callback change-language(int);
    callback change-temp-unit(int);
    callback change-polling-ms(int);

    // Keep standard widget scrollbars synced with active theme
    private property <bool> sync-palette: Theme.use-dark-controls;
    changed sync-palette => {
        Palette.color-scheme = root.sync-palette ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        root.update-breakpoints();
        Palette.color-scheme = root.sync-palette ? ColorScheme.dark : ColorScheme.light;
    }

    function page-title() -> string {
        if (root.current-page == 0) { return I18n.nav-dashboard; }
        if (root.current-page == 1) { return I18n.nav-cpu; }
        if (root.current-page == 2) { return I18n.nav-gpu; }
        if (root.current-page == 3) { return I18n.nav-memory; }
        if (root.current-page == 4) { return I18n.nav-storage; }
        if (root.current-page == 5) { return I18n.nav-system; }
        return I18n.nav-settings;
    }

    function page-subtitle() -> string {
        if (root.current-page == 0) { return I18n.header-subtitle-dashboard; }
        if (root.current-page == 1) { return I18n.header-subtitle-cpu; }
        if (root.current-page == 2) { return I18n.header-subtitle-gpu; }
        if (root.current-page == 3) { return I18n.header-subtitle-memory; }
        if (root.current-page == 4) { return I18n.header-subtitle-storage; }
        if (root.current-page == 5) { return I18n.header-subtitle-system; }
        return I18n.header-subtitle-settings;
    }

    HorizontalLayout {
        if !root.compact-mode : Sidebar {
            current-page <=> root.current-page;
            os-label: root.os-badge-text;
            polling-label: root.polling-badge-text;
        }

        VerticalLayout {
            horizontal-stretch: 1;

            // Header bar (extends cleanly behind Android status bar / display cutout)
            Rectangle {
                background: Theme.bg-header;

                VerticalLayout {
                    if root.safe-area-insets.top > 0px : Rectangle {
                        height: root.safe-area-insets.top;
                    }

                    HorizontalLayout {
                        height: root.compact-mode ? 52px : 58px;
                        padding-left: (root.compact-mode ? 14px : 20px) + root.safe-area-insets.left;
                        padding-right: (root.compact-mode ? 14px : 20px) + root.safe-area-insets.right;
                        spacing: root.compact-mode ? 8px : 16px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: root.page-title();
                                color: Theme.text-primary;
                                font-size: root.compact-mode ? 16px : 17px;
                                font-weight: 700;
                                overflow: elide;
                            }
                            if !root.compact-mode : Text {
                                text: root.page-subtitle();
                                color: Theme.text-secondary;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        // Compact status telemetry strip
                        HorizontalLayout {
                            spacing: root.compact-mode ? 6px : 10px;
                            alignment: end;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 28px;
                                    border-radius: 6px;
                                    background: Theme.bg-elevated;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: root.compact-mode ? 7px : 10px;
                                        padding-right: root.compact-mode ? 7px : 10px;
                                        spacing: 4px;
                                        Text {
                                            text: root.cpu-header-label + ":";
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.dash-cpu-util-text;
                                            color: root.dash-cpu-util-status == 0 ? Theme.accent : (root.dash-cpu-util-status == 3 ? Theme.accent-amber : Theme.text-muted);
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 28px;
                                    border-radius: 6px;
                                    background: Theme.bg-elevated;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: root.compact-mode ? 7px : 10px;
                                        padding-right: root.compact-mode ? 7px : 10px;
                                        spacing: 4px;
                                        Text {
                                            text: "RAM:";
                                            color: Theme.text-muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.ram-util-text;
                                            color: root.ram-util-status == 0 ? Theme.accent-emerald : (root.ram-util-status == 3 ? Theme.accent-amber : Theme.text-muted);
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.border-subtle;
                    }
                }
            }

            // Main content area
            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-app;

                if root.current-page == 0 && Theme.interface-mode == 0 : DashboardPage {
                    width: 100%;
                    height: 100%;
                    compact: root.compact-mode;
                    narrow: root.narrow-mode;
                    left-inset: root.compact-mode ? root.safe-area-insets.left : 0px;
                    right-inset: root.compact-mode ? root.safe-area-insets.right : 0px;
                    cpu-card-label: root.dash-cpu-card-label;
                    cpu-util-text: root.dash-cpu-util-text;
                    cpu-util-percent: root.dash-cpu-util-percent;
                    cpu-util-status: root.dash-cpu-util-status;
                    cpu-secondary-text: root.dash-cpu-secondary-text;
                    cpu-chart-title: root.dash-cpu-chart-title;
                    gpu-util-text: root.dash-gpu-util-text;
                    gpu-util-percent: root.dash-gpu-util-percent;
                    gpu-util-status: root.dash-gpu-util-status;
                    gpu-temp-text: root.dash-gpu-temp-text;
                    ram-util-text: root.ram-util-text;
                    ram-util-percent: root.ram-util-percent;
                    ram-util-status: root.ram-util-status;
                    ram-detail-text: root.ram-detail-text;
                    vram-util-text: root.dash-vram-util-text;
                    vram-util-percent: root.dash-vram-util-percent;
                    vram-util-status: root.dash-vram-util-status;
                    vram-detail-text: root.dash-vram-detail-text;
                    uptime-text: root.uptime-text;
                    uptime-status: root.uptime-status;
                    kernel-text: root.kernel-text;
                    cpu-line-commands: root.cpu-line-commands;
                    cpu-area-commands: root.cpu-area-commands;
                    cpu-has-history: root.cpu-has-history;
                    ram-line-commands: root.ram-line-commands;
                    ram-area-commands: root.ram-area-commands;
                    ram-has-history: root.ram-has-history;
                    gpu-line-commands: root.gpu-line-commands;
                    gpu-area-commands: root.gpu-area-commands;
                    gpu-has-history: root.gpu-has-history;
                    gpu-chart-empty-text: root.gpu-chart-empty-text;
                }

                if root.current-page == 0 && Theme.interface-mode != 0 : PerformancePage {
                    width: 100%; height: 100%; compact: root.compact-mode;
                    open-overlay => { root.current-page = 6; }
                    cpu: root.cpu-sys-util-text; cpu-percent: root.cpu-sys-util-percent; cpu-status: root.cpu-sys-util-status; temperature: root.cpu-temp-text;
                    frequency: root.cpu-freq-text; ram: root.ram-util-text;
                    vram: root.dash-vram-detail-text; gpu: root.selected-gpu;
                    cores: root.cpu-core-rows;
                    cpu-line: root.cpu-line-commands; cpu-area: root.cpu-area-commands; cpu-data: root.cpu-has-history;
                    gpu-line: root.gpu-line-commands; gpu-area: root.gpu-area-commands; gpu-data: root.gpu-has-history;
                }

                if root.current-page == 1 : CpuPage {
                    width: 100%;
                    height: 100%;
                    compact: root.compact-mode;
                    narrow: root.narrow-mode;
                    left-inset: root.compact-mode ? root.safe-area-insets.left : 0px;
                    right-inset: root.compact-mode ? root.safe-area-insets.right : 0px;
                    model-name: root.cpu-model;
                    model-status: root.cpu-model-status;
                    vendor: root.cpu-vendor;
                    vendor-status: root.cpu-vendor-status;
                    arch: root.cpu-arch;
                    cores-threads-text: root.cpu-cores-threads;
                    sys-util-text: root.cpu-sys-util-text;
                    sys-util-percent: root.cpu-sys-util-percent;
                    sys-util-status: root.cpu-sys-util-status;
                    process-util-text: root.cpu-process-util-text;
                    process-util-percent: root.cpu-process-util-percent;
                    process-util-status: root.cpu-process-util-status;
                    chart-title: root.cpu-chart-title;
                    chart-value-text: root.dash-cpu-util-text;
                    freq-text: root.cpu-freq-text;
                    freq-status: root.cpu-freq-status;
                    temp-text: root.cpu-temp-text;
                    temp-source: root.cpu-temp-source;
                    temp-status: root.cpu-temp-status;
                    line-commands: root.cpu-line-commands;
                    area-commands: root.cpu-area-commands;
                    has-history: root.cpu-has-history;
                    notice-text: root.cpu-notice-text;
                    core-rows: root.cpu-core-rows;
                }

                if root.current-page == 2 : GpuPage {
                    width: 100%;
                    height: 100%;
                    compact: root.compact-mode;
                    narrow: root.narrow-mode;
                    left-inset: root.compact-mode ? root.safe-area-insets.left : 0px;
                    right-inset: root.compact-mode ? root.safe-area-insets.right : 0px;
                    gpus: root.gpus;
                    selected-gpu: root.selected-gpu;
                    selected-index: root.selected-gpu-index;
                    has-gpus: root.has-gpus;
                    line-commands: root.gpu-line-commands;
                    area-commands: root.gpu-area-commands;
                    has-history: root.gpu-has-history;
                    chart-empty-text: root.gpu-chart-empty-text;
                    notice-text: root.gpu-notice-text;
                    select-gpu(idx) => { root.select-gpu(idx); }
                }

                if root.current-page == 3 : MemoryPage {
                    width: 100%;
                    height: 100%;
                    compact: root.compact-mode;
                    narrow: root.narrow-mode;
                    left-inset: root.compact-mode ? root.safe-area-insets.left : 0px;
                    right-inset: root.compact-mode ? root.safe-area-insets.right : 0px;
                    total-text: root.mem-total-text;
                    total-status: root.mem-total-status;
                    used-text: root.mem-used-text;
                    used-status: root.mem-used-status;
                    available-text: root.mem-available-text;
                    available-status: root.mem-available-status;
                    util-text: root.ram-util-text;
                    util-percent: root.ram-util-percent;
                    util-status: root.ram-util-status;
                    swap-total-text: root.swap-total-text;
                    swap-total-status: root.swap-total-status;
                    swap-used-text: root.swap-used-text;
                    swap-used-status: root.swap-used-status;
                    swap-util-text: root.swap-util-text;
                    swap-util-percent: root.swap-util-percent;
                    swap-util-status: root.swap-util-status;
                    line-commands: root.ram-line-commands;
                    area-commands: root.ram-area-commands;
                    has-history: root.ram-has-history;
                    notice-text: root.mem-notice-text;
                }

                if root.current-page == 4 : StoragePage {
                    width: 100%;
                    height: 100%;
                    compact: root.compact-mode;
                    left-inset: root.compact-mode ? root.safe-area-insets.left : 0px;
                    right-inset: root.compact-mode ? root.safe-area-insets.right : 0px;
                    disks: root.disks;
                    notice-text: root.storage-notice-text;
                }

                if root.current-page == 5 : SystemPage {
                    width: 100%;
                    height: 100%;
                    compact: root.compact-mode;
                    left-inset: root.compact-mode ? root.safe-area-insets.left : 0px;
                    right-inset: root.compact-mode ? root.safe-area-insets.right : 0px;
                    os-name: root.os-name;
                    os-status: root.os-status;
                    kernel-version: root.kernel-text;
                    kernel-status: root.kernel-status;
                    architecture: root.cpu-arch;
                    hostname: root.hostname;
                    hostname-status: root.hostname-status;
                    uptime-text: root.uptime-text;
                    uptime-status: root.uptime-status;
                    cpu-model: root.cpu-model;
                    cpu-model-status: root.cpu-model-status;
                    cpu-cores-threads: root.cpu-cores-threads;
                    total-ram: root.mem-total-text;
                    total-ram-status: root.mem-total-status;
                    gpus: root.system-gpus;
                }

                if root.current-page == 6 : SettingsPage {
                    width: 100%;
                    height: 100%;
                    compact: root.compact-mode;
                    left-inset: root.compact-mode ? root.safe-area-insets.left : 0px;
                    right-inset: root.compact-mode ? root.safe-area-insets.right : 0px;
                    theme-mode: root.theme-mode;
                    language-mode: root.language-mode;
                    temp-unit: root.temp-unit;
                    polling-ms: root.polling-ms;
                    config-path: root.config-path;
                    overlay-linux: root.overlay-linux; overlay-detected: root.overlay-detected;
                    overlay-enabled: root.overlay-enabled; overlay-position: root.overlay-position;
                    overlay-font: root.overlay-font; overlay-opacity: root.overlay-opacity;
                    overlay-fps: root.overlay-fps; overlay-frametime: root.overlay-frametime;
                    overlay-cpu: root.overlay-cpu; overlay-gpu: root.overlay-gpu;
                    overlay-temperatures: root.overlay-temperatures; overlay-memory: root.overlay-memory;
                    overlay-gpu-power: root.overlay-gpu-power; overlay-opengl-dlsym: root.overlay-opengl-dlsym; overlay-command: root.overlay-command;
                    change-overlay(field, value) => { root.change-overlay(field, value); }
                    refresh-overlay => { root.refresh-overlay(); }
                    manager-config: root.manager-config; manager-status: root.manager-status;
                    manager-preview: root.manager-preview; manager-preview-size: root.manager-preview-size; manager-target: root.manager-target; manager-game: root.manager-game;
                    manager-profiles: root.manager-profiles; manager-flags: root.manager-flags; manager-values: root.manager-values;
                    manager-color: root.manager-color; manager-background: root.manager-background;
                    manage-mangohud(action, name, path, content, confirm) => { root.manage-mangohud(action, name, path, content, confirm); }
                    copy-overlay(command) => { root.copy-overlay(command); }
                    overlay-copy-status: root.overlay-copy-status;
                    custom-theme-json <=> root.custom-theme-json;
                    custom-theme-status: root.custom-theme-status;
                    saved-theme-names: root.saved-theme-names;
                    apply-custom-theme(json, save) => { root.apply-custom-theme(json, save); }
                    load-custom-theme(name) => { root.load-custom-theme(name); }
                    change-palette(v) => { root.change-palette(v); }
                    change-interface(v) => { root.change-interface(v); }
                    change-accent(v) => { root.change-accent(v); }
                    change-theme(v) => { root.change-theme(v); }
                    change-language(v) => { root.change-language(v); }
                    change-temp-unit(v) => { root.change-temp-unit(v); }
                    change-polling-ms(v) => { root.change-polling-ms(v); }
                }
            }

            if root.compact-mode : BottomNav {
                current-page <=> root.current-page;
                bottom-inset: root.safe-area-insets.bottom;
                left-inset: root.safe-area-insets.left;
                right-inset: root.safe-area-insets.right;
            }
        }
    }
}

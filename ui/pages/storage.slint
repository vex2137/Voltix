import { ScrollView } from "std-widgets.slint";
import { Theme } from "../themes/theme.slint";
import { I18n } from "../i18n/strings.slint";
import { StorageItem } from "../models.slint";
import { Card, ProgressBar } from "../components/common.slint";

export component StoragePage inherits Rectangle {
    in property <[StorageItem]> disks;

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            width: max(300px, root.width - 14px);
            alignment: start;
            padding: 20px;
            spacing: 12px;

            if root.disks.length == 0 : Card {
                min-height: 140px;

                Text {
                    text: I18n.storage-empty;
                    color: Theme.text-muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            for disk in root.disks : Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: disk.mount-point;
                                color: Theme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                            }
                            Text {
                                text: disk.device + "  •  " + disk.filesystem;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: disk.percent-text;
                            color: disk.status == 0 ? Theme.accent : Theme.text-muted;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    ProgressBar {
                        value: disk.percent;
                        available: disk.status == 0;
                        bar-color: disk.percent > 90.0 ? Theme.accent-red : (disk.percent > 75.0 ? Theme.accent-amber : Theme.accent);
                    }

                    HorizontalLayout {
                        spacing: 24px;

                        Text {
                            text: I18n.storage-used + ": " + disk.used-text;
                            color: Theme.text-secondary;
                            font-size: 12px;
                        }
                        Text {
                            text: I18n.storage-available + ": " + disk.available-text;
                            color: Theme.text-secondary;
                            font-size: 12px;
                        }
                        Text {
                            text: I18n.storage-total + ": " + disk.total-text;
                            color: Theme.text-secondary;
                            font-size: 12px;
                        }
                    }
                }
            }
        }
    }
}

import { ControlRow } from "../models.slint";
import { TelemetryRows } from "../components/telemetry-rows.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../themes/theme.slint";
import { I18n } from "../i18n/strings.slint";
import { StorageItem } from "../models.slint";
import { Card, SectionTitle, DiagnosticNotice, ProgressBar } from "../components/common.slint";

export component StoragePage inherits Rectangle {
    in property <[ControlRow]> activity;
    in property <bool> compact: false;
    in property <length> left-inset: 0px;
    in property <length> right-inset: 0px;
    in property <[StorageItem]> disks;
    in property <string> notice-text;

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            width: max(0px, min(1200px, root.width - 14px));
            alignment: start;
            padding-top: Theme.interface-mode == 1 ? 8px : (root.compact ? 12px : 24px);
            padding-bottom: root.compact ? 16px : 20px;
            padding-left: (root.compact ? 12px : 20px) + root.left-inset;
            padding-right: (root.compact ? 12px : 20px) + root.right-inset;
            spacing: 12px;
            if root.activity.length > 0 : Card { VerticalLayout { padding: 14px; spacing: 8px; SectionTitle { text: I18n.cc-activity; } TelemetryRows { rows: root.activity; } } }


            if root.disks.length == 0 : Card {
                min-height: 140px;

                VerticalLayout {
                    padding: 20px;
                    alignment: center;

                    Text {
                        text: I18n.storage-empty;
                        color: Theme.text-muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            for disk in root.disks : Card {
                VerticalLayout {
                    padding: root.compact ? 14px : 16px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 2px;

                            Text {
                                text: disk.mount-point;
                                color: Theme.text-primary;
                                font-size: 15px;
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                            Text {
                                text: disk.device + "  •  " + disk.filesystem;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }

                        Text {
                            text: disk.percent-text;
                            color: disk.status == 0 ? Theme.accent : (disk.status == 3 ? Theme.accent-amber : Theme.text-muted);
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    ProgressBar {
                        value: disk.percent;
                        available: disk.status == 0;
                        bar-color: disk.percent > 90.0 ? Theme.accent-red : (disk.percent > 75.0 ? Theme.accent-amber : Theme.accent);
                    }

                    if !root.compact : HorizontalLayout {
                        spacing: 24px;

                        Text {
                            text: I18n.storage-used + ": " + disk.used-text;
                            color: Theme.text-secondary;
                            font-size: 12px;
                        }
                        Text {
                            text: I18n.storage-available + ": " + disk.available-text;
                            color: Theme.text-secondary;
                            font-size: 12px;
                        }
                        Text {
                            text: I18n.storage-total + ": " + disk.total-text;
                            color: Theme.text-secondary;
                            font-size: 12px;
                        }
                    }

                    if root.compact : VerticalLayout {
                        spacing: 4px;

                        HorizontalLayout {
                            spacing: 12px;
                            Text {
                                text: I18n.storage-used + ": " + disk.used-text;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            Text {
                                text: I18n.storage-available + ": " + disk.available-text;
                                color: Theme.text-secondary;
                                font-size: 12px;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }

                        Text {
                            text: I18n.storage-total + ": " + disk.total-text;
                            color: Theme.text-secondary;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            if root.notice-text != "" : DiagnosticNotice {
                compact: root.compact;
                title: I18n.diag-notice-title;
                body: root.notice-text;
            }
        }
    }
}

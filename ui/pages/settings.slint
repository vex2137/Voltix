import { ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "../themes/theme.slint";
import { I18n } from "../i18n/strings.slint";
import { Card, KeyValueRow, SectionTitle, SegmentedOption } from "../components/common.slint";

export component SettingsPage inherits Rectangle {
    in property <bool> compact: false;
    in property <length> left-inset: 0px;
    in property <length> right-inset: 0px;
    in property <int> theme-mode: 1; // 0=System, 1=Dark, 2=Light
    in property <int> language-mode: 0; // 0=System, 1=English, 2=Polish
    in property <int> temp-unit: 0; // 0=Celsius, 1=Fahrenheit
    in property <int> polling-ms: 1000;
    in property <string> config-path;

    in property <bool> overlay-linux;
    in property <bool> overlay-detected;
    in property <bool> overlay-enabled;
    in property <int> overlay-position;
    in property <int> overlay-font;
    in property <int> overlay-opacity;
    in property <bool> overlay-fps;
    in property <bool> overlay-frametime;
    in property <bool> overlay-cpu;
    in property <bool> overlay-gpu;
    in property <bool> overlay-temperatures;
    in property <bool> overlay-memory;
    in property <bool> overlay-gpu-power;
    in property <bool> overlay-opengl-dlsym;
    in property <string> overlay-command;
    callback change-overlay(int, int);
    callback refresh-overlay();
    in-out property <string> custom-theme-json;
    in property <string> custom-theme-status;
    in property <[string]> saved-theme-names;
    callback apply-custom-theme(string, int);
    callback load-custom-theme(string);
    callback change-palette(int);
    callback change-interface(int);
    callback change-accent(int);
    callback change-theme(int);
    callback change-language(int);
    callback change-temp-unit(int);
    callback change-polling-ms(int);

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            width: root.compact ? root.width : min(1200px, max(280px, root.width - 14px));
            alignment: start;
            padding-top: Theme.interface-mode == 1 ? 8px : (root.compact ? 12px : 24px);
            padding-bottom: root.compact ? 16px : 20px;
            padding-left: (root.compact ? 12px : 20px) + root.left-inset;
            padding-right: (root.compact ? 12px : 20px) + root.right-inset;
            spacing: root.compact ? 12px : 16px;

            Card {
                VerticalLayout {
                    padding: root.compact ? 14px : 16px;
                    spacing: 12px;

                    SectionTitle {
                        text: I18n.settings-appearance;
                    }

                    Text { text: Theme.polish ? "Paleta kolorów" : "Color palette"; color: Theme.text-secondary; }
                    VerticalLayout {
                        spacing: 6px;
                        for label[index] in ["Voltix Default", "Cyberpunk", "Emerald", "Minimal", Theme.polish ? "Własny" : "Custom"] : SegmentedOption {
                            compact: true; label: label;
                            active: Theme.palette == index;
                            clicked => { root.change-palette(index); }
                        }
                    }
                    if Theme.palette == 4 : VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: Theme.polish ? "Edytuj lub wklej JSON motywu; skopiuj go, aby wyeksportować. Kolory #RRGGBB muszą mieć kontrast co najmniej 4,5:1 z tłem i powierzchnią." : "Edit or paste theme JSON; copy it to export. #RRGGBB colors must have at least 4.5:1 contrast against background and surface.";
                            color: Theme.text-secondary; wrap: word-wrap;
                        }
                        TextEdit { height: 220px; text <=> root.custom-theme-json; wrap: word-wrap; }
                        SegmentedOption { height: 44px; label: Theme.polish ? "Zastosuj / importuj JSON" : "Apply / import JSON"; clicked => { root.apply-custom-theme(root.custom-theme-json, 0); } }
                        SegmentedOption { height: 44px; label: Theme.polish ? "Zapisz motyw pod nazwą z JSON" : "Save theme using JSON name"; clicked => { root.apply-custom-theme(root.custom-theme-json, 1); } }
                        if root.custom-theme-status != "" : Text { text: root.custom-theme-status; color: Theme.text-primary; wrap: word-wrap; }
                        if root.saved-theme-names.length > 0 : Text { text: Theme.polish ? "Zapisane motywy" : "Saved themes"; color: Theme.text-secondary; }
                        for name in root.saved-theme-names : SegmentedOption { height: 44px; label: name; clicked => { root.load-custom-theme(name); } }
                    }
                    if Theme.palette != 0 && Theme.palette != 4 : Text {
                        text: Theme.polish ? "Paleta ma ciemne tło. Wybór motywu lub akcentu przywróci paletę domyślną." : "This palette uses dark surfaces. Choosing a theme or accent restores the default palette.";
                        color: Theme.text-secondary; wrap: word-wrap;
                    }
                    Text { text: Theme.polish ? "Tryb interfejsu" : "Interface Mode"; color: Theme.text-secondary; }
                    VerticalLayout {
                        spacing: 6px;
                        for label[index] in ["Modern", "Professional", "Gaming"] : SegmentedOption {
                            compact: true;
                            label: label;
                            active: Theme.interface-mode == index;
                            clicked => { root.change-interface(index); }
                        }
                    }
                    if Theme.palette == 0 : Text { text: Theme.polish ? "Kolor akcentu" : "Accent color"; color: Theme.text-secondary; }
                    if Theme.palette == 0 : HorizontalLayout {
                        spacing: 8px;
                        for color[index] in [#38bdf8, #a78bfa, #10b981, #f97316] : TouchArea {
                            height: 44px;
                            horizontal-stretch: 1;
                            Rectangle { background: color; border-radius: 6px; border-width: Theme.accent-index == index ? 3px : 0px; border-color: Theme.text-primary; }
                            clicked => { root.change-accent(index); }
                        }
                    }

                    if !root.compact : HorizontalLayout {
                        spacing: 16px;

                        Text {
                            text: I18n.settings-theme;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            SegmentedOption {
                                label: I18n.settings-theme-system;
                                active: root.theme-mode == 0;
                                clicked => { root.change-theme(0); }
                            }
                            SegmentedOption {
                                label: I18n.settings-theme-dark;
                                active: root.theme-mode == 1;
                                clicked => { root.change-theme(1); }
                            }
                            SegmentedOption {
                                label: I18n.settings-theme-light;
                                active: root.theme-mode == 2;
                                clicked => { root.change-theme(2); }
                            }
                        }
                    }

                    if root.compact : VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: I18n.settings-theme;
                            color: Theme.text-secondary;
                            font-size: 13px;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: I18n.settings-theme-system;
                                active: root.theme-mode == 0;
                                clicked => { root.change-theme(0); }
                            }
                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: I18n.settings-theme-dark;
                                active: root.theme-mode == 1;
                                clicked => { root.change-theme(1); }
                            }
                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: I18n.settings-theme-light;
                                active: root.theme-mode == 2;
                                clicked => { root.change-theme(2); }
                            }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: root.compact ? 14px : 16px; spacing: 10px;
                    SectionTitle { text: Theme.polish ? "Nakładka MangoHud" : "MangoHud overlay"; }
                    if !root.overlay-linux : Text {
                        text: Theme.polish ? "MangoHud jest dostępny tylko w Linuksie. Android nie udostępnia uniwersalnej nakładki w grze." : "MangoHud is Linux-only. Android does not provide a universal in-game overlay.";
                        color: Theme.text-secondary; wrap: word-wrap;
                    }
                    if root.overlay-linux : VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: root.overlay-detected ? (Theme.polish ? "Wykryto program MangoHud; obsługa gry zależy od środowiska." : "MangoHud executable detected; game support depends on the environment.") : (Theme.polish ? "Nie znaleziono programu MangoHud w PATH." : "MangoHud executable not found in PATH.");
                            color: Theme.text-secondary; wrap: word-wrap;
                        }
                        Text {
                            text: Theme.polish ? "Odczyty zapewnia MangoHud; dostępność czujników zależy od sterownika." : "MangoHud supplies these readings; sensor availability depends on the driver.";
                            color: Theme.text-secondary; wrap: word-wrap;
                        }
                        SegmentedOption { height: 44px; label: Theme.polish ? "Sprawdź ponownie" : "Check again"; clicked => { root.refresh-overlay(); } }
                        Text {
                            text: Theme.polish ? "Skopiuj opcje do ustawień gry w Steam. Nadpisują one konfigurację MangoHud dla tej gry i nie wpływają na działające gry. Poza Steam zastąp %command% poleceniem gry." : "Copy these options into the game's Steam launch settings. They override MangoHud config for that game and do not affect running games. Outside Steam, replace %command% with the game command.";
                            color: Theme.text-secondary; wrap: word-wrap;
                        }
                        SegmentedOption {
                            height: 44px;
                            label: Theme.polish ? "Uwzględnij MangoHud w poleceniu" : "Include MangoHud in launch options";
                            active: root.overlay-enabled;
                            clicked => { root.change-overlay(10, root.overlay-enabled ? 0 : 1); }
                        }
                        SegmentedOption {
                            height: 44px; label: Theme.polish ? "Zgodność OpenGL (--dlsym)" : "OpenGL compatibility (--dlsym)";
                            active: root.overlay-opengl-dlsym;
                            clicked => { root.change-overlay(11, root.overlay-opengl-dlsym ? 0 : 1); }
                        }
                        Text { text: Theme.polish ? "Metryki" : "Metrics"; color: Theme.text-secondary; }
                        for label[index] in ["FPS", "Frametime", "CPU", "GPU", Theme.polish ? "Temperatury" : "Temperatures", "RAM / VRAM", Theme.polish ? "Pobór mocy GPU" : "GPU power draw"] : SegmentedOption {
                            height: 44px; label: label;
                            active: index == 0 ? root.overlay-fps : (index == 1 ? root.overlay-frametime : (index == 2 ? root.overlay-cpu : (index == 3 ? root.overlay-gpu : (index == 4 ? root.overlay-temperatures : (index == 5 ? root.overlay-memory : root.overlay-gpu-power)))));
                            clicked => { root.change-overlay(index, self.active ? 0 : 1); }
                        }
                        Text { text: Theme.polish ? "Pozycja" : "Position"; color: Theme.text-secondary; }
                        for label[index] in [Theme.polish ? "Lewy górny" : "Top left", Theme.polish ? "Prawy górny" : "Top right", Theme.polish ? "Lewy dolny" : "Bottom left", Theme.polish ? "Prawy dolny" : "Bottom right"] : SegmentedOption {
                            height: 44px; label: label; active: root.overlay-position == index;
                            clicked => { root.change-overlay(7, index); }
                        }
                        Text { text: Theme.polish ? "Rozmiar tekstu" : "Text size"; color: Theme.text-secondary; }
                        for size in [18, 24, 32] : SegmentedOption {
                            height: 44px; label: size + " px"; active: root.overlay-font == size;
                            clicked => { root.change-overlay(8, size); }
                        }
                        Text { text: Theme.polish ? "Krycie" : "Opacity"; color: Theme.text-secondary; }
                        for value in [25, 50, 75, 100] : SegmentedOption {
                            height: 44px; label: value + "%"; active: root.overlay-opacity == value;
                            clicked => { root.change-overlay(9, value); }
                        }
                        Text { text: Theme.polish ? "Opcje uruchamiania — podgląd" : "Launch options preview"; color: Theme.text-secondary; }
                        TextEdit { height: 100px; text: root.overlay-command; read-only: true; wrap: word-wrap; }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: root.compact ? 14px : 16px;
                    spacing: 14px;

                    SectionTitle {
                        text: I18n.settings-localization;
                    }

                    if !root.compact : HorizontalLayout {
                        spacing: 16px;

                        Text {
                            text: I18n.settings-language;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            SegmentedOption {
                                label: I18n.settings-lang-system;
                                active: root.language-mode == 0;
                                clicked => { root.change-language(0); }
                            }
                            SegmentedOption {
                                label: I18n.settings-lang-en;
                                active: root.language-mode == 1;
                                clicked => { root.change-language(1); }
                            }
                            SegmentedOption {
                                label: I18n.settings-lang-pl;
                                active: root.language-mode == 2;
                                clicked => { root.change-language(2); }
                            }
                        }
                    }

                    if root.compact : VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: I18n.settings-language;
                            color: Theme.text-secondary;
                            font-size: 13px;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: I18n.settings-lang-system;
                                active: root.language-mode == 0;
                                clicked => { root.change-language(0); }
                            }
                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: I18n.settings-lang-en;
                                active: root.language-mode == 1;
                                clicked => { root.change-language(1); }
                            }
                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: I18n.settings-lang-pl;
                                active: root.language-mode == 2;
                                clicked => { root.change-language(2); }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    if !root.compact : HorizontalLayout {
                        spacing: 16px;

                        Text {
                            text: I18n.settings-temp-unit;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            SegmentedOption {
                                label: "°C";
                                active: root.temp-unit == 0;
                                clicked => { root.change-temp-unit(0); }
                            }
                            SegmentedOption {
                                label: "°F";
                                active: root.temp-unit == 1;
                                clicked => { root.change-temp-unit(1); }
                            }
                        }
                    }

                    if root.compact : VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: I18n.settings-temp-unit;
                            color: Theme.text-secondary;
                            font-size: 13px;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: "°C";
                                active: root.temp-unit == 0;
                                clicked => { root.change-temp-unit(0); }
                            }
                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: "°F";
                                active: root.temp-unit == 1;
                                clicked => { root.change-temp-unit(1); }
                            }
                        }
                    }
                }
            }

            Card {
                VerticalLayout {
                    padding: root.compact ? 14px : 16px;
                    spacing: 14px;

                    SectionTitle {
                        text: I18n.settings-monitoring;
                    }

                    if !root.compact : HorizontalLayout {
                        spacing: 16px;

                        Text {
                            text: I18n.settings-polling-interval;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            SegmentedOption {
                                label: "250 ms";
                                active: root.polling-ms == 250;
                                clicked => { root.change-polling-ms(250); }
                            }
                            SegmentedOption {
                                label: "500 ms";
                                active: root.polling-ms == 500;
                                clicked => { root.change-polling-ms(500); }
                            }
                            SegmentedOption {
                                label: "1000 ms";
                                active: root.polling-ms == 1000;
                                clicked => { root.change-polling-ms(1000); }
                            }
                            SegmentedOption {
                                label: "2000 ms";
                                active: root.polling-ms == 2000;
                                clicked => { root.change-polling-ms(2000); }
                            }
                            SegmentedOption {
                                label: "5000 ms";
                                active: root.polling-ms == 5000;
                                clicked => { root.change-polling-ms(5000); }
                            }
                        }
                    }

                    if root.compact : VerticalLayout {
                        spacing: 8px;

                        Text {
                            text: I18n.settings-polling-interval;
                            color: Theme.text-secondary;
                            font-size: 13px;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: "250 ms";
                                active: root.polling-ms == 250;
                                clicked => { root.change-polling-ms(250); }
                            }
                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: "500 ms";
                                active: root.polling-ms == 500;
                                clicked => { root.change-polling-ms(500); }
                            }
                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: "1000 ms";
                                active: root.polling-ms == 1000;
                                clicked => { root.change-polling-ms(1000); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: "2000 ms";
                                active: root.polling-ms == 2000;
                                clicked => { root.change-polling-ms(2000); }
                            }
                            SegmentedOption {
                                compact: true;
                                horizontal-stretch: 1;
                                label: "5000 ms";
                                active: root.polling-ms == 5000;
                                clicked => { root.change-polling-ms(5000); }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    KeyValueRow {
                        compact: root.compact;
                        label: I18n.settings-config-path;
                        value: root.config-path;
                        show-divider: false;
                    }

                    Text {
                        text: I18n.settings-saved-auto;
                        color: Theme.text-muted;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

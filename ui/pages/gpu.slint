import { AdvancedGpu } from "../components/advanced-gpu.slint";
import { ControlRow } from "../models.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../themes/theme.slint";
import { I18n } from "../i18n/strings.slint";
import { GpuItem } from "../models.slint";
import { Card, DiagnosticNotice, KeyValueRow, SectionTitle, SegmentedOption, SummaryCard } from "../components/common.slint";
import { TelemetryChart } from "../components/chart.slint";

export component GpuPage inherits Rectangle {
    in property <bool> android-platform;
    in-out property <bool> shizuku-enabled;
    in property <bool> shizuku-running;
    in property <bool> shizuku-authorized;
    in property <bool> shizuku-installed;
    in property <[ControlRow]> shizuku-rows;
    in property <[ControlRow]> shizuku-sources;
    callback shizuku-action(int);
    in property <bool> compact: false;
    in property <bool> narrow: false;
    in property <length> left-inset: 0px;
    in property <length> right-inset: 0px;

    in property <[GpuItem]> gpus;
    in property <GpuItem> selected-gpu;
    in property <int> selected-index: 0;
    in property <bool> has-gpus: false;

    in property <string> line-commands;
    in property <string> area-commands;
    in property <bool> has-history;
    in property <string> chart-empty-text;
    in property <string> notice-text;

    callback select-gpu(int);

    ScrollView {
        width: 100%;
        height: 100%;

        VerticalLayout {
            width: max(0px, min(1200px, root.width - 14px));
            alignment: start;
            padding-top: Theme.interface-mode == 1 ? 8px : (root.compact ? 12px : 24px);
            padding-bottom: root.compact ? 16px : 20px;
            padding-left: (root.compact ? 12px : 20px) + root.left-inset;
            padding-right: (root.compact ? 12px : 20px) + root.right-inset;
            spacing: root.compact ? 12px : 16px;

            if root.android-platform : AdvancedGpu {
                enabled <=> root.shizuku-enabled; running: root.shizuku-running;
                authorized: root.shizuku-authorized; installed: root.shizuku-installed;
                rows: root.shizuku-rows; sources: root.shizuku-sources;
                action(command) => { root.shizuku-action(command); }
            }
            if !root.has-gpus : Card {
                min-height: 160px;

                VerticalLayout {
                    padding: 24px;
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: I18n.gpu-none-detected;
                        color: Theme.text-secondary;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: I18n.status-unavailable;
                        color: Theme.text-muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                    }
                }
            }

            if root.has-gpus && root.gpus.length > 1 : Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;

                    SectionTitle {
                        text: I18n.gpu-selector;
                    }

                    if !root.compact : HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        for gpu[idx] in root.gpus : SegmentedOption {
                            label: gpu.name;
                            active: idx == root.selected-index;
                            clicked => { root.select-gpu(idx); }
                        }
                    }

                    if root.compact : VerticalLayout {
                        spacing: 8px;

                        for gpu[idx] in root.gpus : SegmentedOption {
                            compact: true;
                            label: gpu.name;
                            active: idx == root.selected-index;
                            clicked => { root.select-gpu(idx); }
                        }
                    }
                }
            }

            if root.has-gpus : VerticalLayout {
                spacing: root.compact ? 12px : 16px;

                if !root.compact : HorizontalLayout {
                    spacing: 12px;

                    SummaryCard {
                        horizontal-stretch: 1;
                        label: I18n.gpu-utilization;
                        primary-value: root.selected-gpu.util-text;
                        progress: root.selected-gpu.util-percent;
                        status: root.selected-gpu.util-status;
                        accent-color: Theme.gpu-color;
                    }

                    SummaryCard {
                        horizontal-stretch: 1;
                        label: I18n.gpu-vram;
                        primary-value: root.selected-gpu.vram-text;
                        secondary-value: root.selected-gpu.vram-subtext;
                        progress: root.selected-gpu.vram-percent;
                        status: root.selected-gpu.vram-status;
                        accent-color: Theme.accent-amber;
                    }

                    SummaryCard {
                        horizontal-stretch: 1;
                        label: I18n.gpu-temperature;
                        primary-value: root.selected-gpu.temp-text;
                        show-progress: false;
                        status: root.selected-gpu.temp-status;
                    }

                    SummaryCard {
                        horizontal-stretch: 1;
                        label: I18n.gpu-power-draw;
                        primary-value: root.selected-gpu.power-draw-text;
                        secondary-value: root.selected-gpu.power-limit-text;
                        show-progress: false;
                        status: root.selected-gpu.power-draw-status;
                    }
                }

                if root.compact && !root.narrow : VerticalLayout {
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 10px;

                        SummaryCard {
                            compact: true;
                            horizontal-stretch: 1;
                            label: I18n.gpu-utilization;
                            primary-value: root.selected-gpu.util-text;
                            progress: root.selected-gpu.util-percent;
                            status: root.selected-gpu.util-status;
                            accent-color: Theme.gpu-color;
                        }

                        SummaryCard {
                            compact: true;
                            horizontal-stretch: 1;
                            label: I18n.gpu-vram;
                            primary-value: root.selected-gpu.vram-text;
                            secondary-value: root.selected-gpu.vram-subtext;
                            progress: root.selected-gpu.vram-percent;
                            status: root.selected-gpu.vram-status;
                            accent-color: Theme.accent-amber;
                        }
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        SummaryCard {
                            compact: true;
                            horizontal-stretch: 1;
                            label: I18n.gpu-temperature;
                            primary-value: root.selected-gpu.temp-text;
                            show-progress: false;
                            status: root.selected-gpu.temp-status;
                        }

                        SummaryCard {
                            compact: true;
                            horizontal-stretch: 1;
                            label: I18n.gpu-power-draw;
                            primary-value: root.selected-gpu.power-draw-text;
                            secondary-value: root.selected-gpu.power-limit-text;
                            show-progress: false;
                            status: root.selected-gpu.power-draw-status;
                        }
                    }
                }

                if root.compact && root.narrow : VerticalLayout {
                    spacing: 10px;

                    SummaryCard {
                        compact: true;
                        label: I18n.gpu-utilization;
                        primary-value: root.selected-gpu.util-text;
                        progress: root.selected-gpu.util-percent;
                        status: root.selected-gpu.util-status;
                        accent-color: Theme.gpu-color;
                    }

                    SummaryCard {
                        compact: true;
                        label: I18n.gpu-vram;
                        primary-value: root.selected-gpu.vram-text;
                        secondary-value: root.selected-gpu.vram-subtext;
                        progress: root.selected-gpu.vram-percent;
                        status: root.selected-gpu.vram-status;
                        accent-color: Theme.accent-amber;
                    }

                    SummaryCard {
                        compact: true;
                        label: I18n.gpu-temperature;
                        primary-value: root.selected-gpu.temp-text;
                        show-progress: false;
                        status: root.selected-gpu.temp-status;
                    }

                    SummaryCard {
                        compact: true;
                        label: I18n.gpu-power-draw;
                        primary-value: root.selected-gpu.power-draw-text;
                        secondary-value: root.selected-gpu.power-limit-text;
                        show-progress: false;
                        status: root.selected-gpu.power-draw-status;
                    }
                }

                if root.notice-text != "" : DiagnosticNotice {
                    compact: root.compact;
                    title: I18n.diag-notice-title;
                    body: root.notice-text;
                }

                Card {
                    VerticalLayout {
                        padding: root.compact ? 14px : 16px;
                        spacing: 4px;

                        KeyValueRow {
                            compact: root.compact;
                            label: I18n.gpu-name;
                            value: root.selected-gpu.name;
                        }
                        KeyValueRow {
                            compact: root.compact;
                            label: I18n.gpu-vendor;
                            value: root.selected-gpu.vendor-name;
                        }
                        KeyValueRow {
                            compact: root.compact;
                            label: I18n.gpu-driver;
                            value: root.selected-gpu.driver-text;
                            status: root.selected-gpu.driver-status;
                        }
                        KeyValueRow {
                            compact: root.compact;
                            label: I18n.gpu-core-clock;
                            value: root.selected-gpu.core-clock-text;
                            status: root.selected-gpu.core-clock-status;
                        }
                        KeyValueRow {
                            compact: root.compact;
                            label: I18n.gpu-mem-clock;
                            value: root.selected-gpu.mem-clock-text;
                            status: root.selected-gpu.mem-clock-status;
                        }
                        KeyValueRow {
                            compact: root.compact;
                            label: I18n.gpu-power-limit;
                            value: root.selected-gpu.power-limit-text;
                            status: root.selected-gpu.power-limit-status;
                        }
                        KeyValueRow {
                            compact: root.compact;
                            label: I18n.gpu-fan-speed;
                            value: root.selected-gpu.fan-text;
                            status: root.selected-gpu.fan-status;
                            show-divider: false;
                        }
                    }
                }

                TelemetryChart {
                    compact: root.compact;
                    title: I18n.gpu-history-title;
                    current-value-text: root.selected-gpu.util-text;
                    line-commands: root.line-commands;
                    area-commands: root.area-commands;
                    has-data: root.has-history;
                    empty-text: root.chart-empty-text;
                    line-color: Theme.gpu-color;
                    area-color: Theme.gpu-color.with-alpha(0.14);
                }
            }
        }
    }
}

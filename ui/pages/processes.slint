import { ListView, LineEdit, ComboBox, CheckBox, Button } from "std-widgets.slint";
import { Theme } from "../themes/theme.slint";
import { I18n } from "../i18n/strings.slint";
import { ControlRow, ControlSummary, ProcessItem } from "../models.slint";
import { Card } from "../components/common.slint";
import { ProcessRow } from "../components/process-row.slint";
import { ProcessDetails } from "../components/process-details.slint";
export component ProcessesPage inherits Rectangle {
    // The page fills the content area; table contents must not enlarge the window.
    min-width: 0px; preferred-width: 0px; max-width: 100000px; horizontal-stretch: 1;
    min-height: 0px; preferred-height: 0px; max-height: 100000px; vertical-stretch: 1;
    in property <bool> android-platform;
    in property <length> left-inset;
    in property <length> right-inset;
    in property <[ProcessItem]> rows;
    in property <[ControlSummary]> summaries;
    in property <[ControlRow]> details;
    in property <string> detail-note;
    in property <string> count-note;
    in property <bool> available;
    in-out property <string> filter;
    in-out property <int> sort;
    in-out property <bool> descending: true;
    in-out property <int> quick;
    in-out property <bool> own;
    in-out property <string> selected;
    in property <int> selected-index: -1;
    private property <bool> keyboard-navigation: false;
    changed filter => { root.keyboard-navigation = false; }
    changed sort => { root.keyboard-navigation = false; }
    changed quick => { root.keyboard-navigation = false; }
    changed own => { root.keyboard-navigation = false; }
    private property <bool> short: root.height < 640px;
    private property <int> columns: root.width >= 850px || (!root.android-platform && root.width >= 500px) || (root.short && root.width >= 500px) ? 3 : 2;
    VerticalLayout {
        padding-top: 12px; padding-bottom: 12px;
        padding-left: 12px + root.left-inset; padding-right: 12px + root.right-inset;
        spacing: 8px;
        if root.available && root.summaries.length >= 6 : VerticalLayout {
            spacing: 6px;
            for r in (root.columns == 3 ? 2 : 3) : HorizontalLayout {
                spacing: 6px;
                for c in root.columns : Card {
                    height: root.short ? (root.android-platform ? 44px : 48px) : 64px;
                    horizontal-stretch: 1; min-width: 0px; preferred-width: 0px; max-width: 100000px;
                    accessible-role: text;
                    accessible-label: root.summaries[r * root.columns + c].label + " " + root.summaries[r * root.columns + c].value + " " + root.summaries[r * root.columns + c].detail;
                    VerticalLayout {
                        padding: 6px; spacing: 2px;
                        Text { text: root.summaries[r * root.columns + c].label; font-size: 10px; color: Theme.text-muted; overflow: elide; }
                        Text { text: root.summaries[r * root.columns + c].value + (root.short && r * root.columns + c >= 4 ? " · " + root.summaries[r * root.columns + c].detail : ""); font-size: root.short ? 14px : 17px; font-weight: 600; color: Theme.text-primary; overflow: elide; }
                        if !root.short : Text { text: root.summaries[r * root.columns + c].detail; font-size: 11px; color: Theme.text-secondary; overflow: elide; }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            LineEdit { changed has-focus => { if self.has-focus { root.keyboard-navigation = false; } } text <=> root.filter; placeholder-text: I18n.cc-filter; horizontal-stretch: 1; min-width: 0px; }
            ComboBox { model: [I18n.cc-sort-cpu,I18n.cc-sort-memory,I18n.cc-sort-pid,I18n.proc-sort-name]; current-index <=> root.sort; width: root.width < 650px ? 140px : 170px; }
            Button { text: root.descending ? "↓" : "↑"; accessible-label: root.descending ? I18n.proc-descending : I18n.proc-ascending; width: 32px; clicked => { root.descending = !root.descending; } }
        }
        HorizontalLayout {
            spacing: 6px;
            for quick in (root.android-platform ? [1,2] : [0,1,2]) : Button { min-height: root.android-platform ? 0px : 28px; text: quick == 0 ? I18n.proc-all : (quick == 1 ? I18n.proc-high-cpu : I18n.proc-high-ram); primary: root.quick == quick; clicked => { root.quick = root.quick == quick ? 0 : quick; } }
            CheckBox { text: I18n.proc-own; checked <=> root.own; }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: root.available ? root.count-note : I18n.cc-process-unavailable; color: Theme.text-secondary; font-size: 11px; wrap: word-wrap; }
        HorizontalLayout {
            vertical-stretch: 1; spacing: 10px;
            Card {
                horizontal-stretch: 1; min-width: 0px;
                VerticalLayout {
                    padding: 4px; spacing: 2px;
                    Rectangle { height: 30px; min-width: 0px; preferred-width: 0px; max-width: 100000px; horizontal-stretch: 1; ProcessRow { header: true; desktop: !root.android-platform; width: list.visible-width; } }
                    if root.rows.length == 0 : Text { text: root.available ? I18n.proc-no-match : I18n.cc-sample-wait; color: Theme.text-muted; wrap: word-wrap; }
                    list := ListView {
                        vertical-stretch: 1; min-height: 64px;
                        for row[index] in root.rows : ProcessRow {
                            item: row; row-index: index; desktop: !root.android-platform; width: list.visible-width; selected: root.selected == row.key; keyboard-select: root.keyboard-navigation;
                            activate(key) => { root.keyboard-navigation = false; root.selected = key; }
                            step(direction) => {
                                if root.selected-index + direction >= 0 && root.selected-index + direction < root.rows.length {
                                    root.keyboard-navigation = true;
                                    if (root.selected-index + direction) * 40px < -list.content-y {
                                        list.content-y = -(root.selected-index + direction) * 40px;
                                    } else if (root.selected-index + direction + 1) * 40px > -list.content-y + list.visible-height {
                                        list.content-y = min(0px, list.visible-height - (root.selected-index + direction + 1) * 40px);
                                    }
                                    root.selected = root.rows[root.selected-index + direction].key;
                                }
                            }
                        }
                    }
                }
            }
            if root.selected != "" && root.width >= 1050px : ProcessDetails { width: 300px; rows: root.details; note: root.detail-note; close => { root.selected = ""; } }
        }
        if root.height >= 600px : Text { text: I18n.proc-note + " " + I18n.proc-tasks-note; font-size: 10px; color: Theme.text-muted; wrap: word-wrap; }
    }
    // A dismissible details drawer keeps all table columns readable on narrow windows.
    if root.selected != "" && root.width < 1050px : Rectangle {
        width: 100%; height: 100%; background: #00000055;
        TouchArea { clicked => { root.selected = ""; } }
        ProcessDetails { x: parent.width - self.width - 8px; y: 8px; width: min(380px, parent.width - 16px); height: parent.height - 16px; rows: root.details; note: root.detail-note; close => { root.selected = ""; } }
    }
}
